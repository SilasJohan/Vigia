# --- Telegram (obrigatório) ---
# Crie o bot no @BotFather -> /newbot -> copie o token
TELEGRAM_TOKEN=123456:ABC-DEF...
# Seu chat pessoal, para receber erros e relatórios de operação.
# Descubra rodando: python -m vigia whoami  (depois de mandar /start no bot)
ADMIN_CHAT_ID=

# --- IA (escolha um; todos têm free tier sem cartão) ---
# auto = tenta groq -> gemini -> ollama -> heurística local
AI_PROVIDER=auto

# https://console.groq.com/keys  (free, ~30 req/min)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# https://aistudio.google.com/apikey  (free)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama local - o trilho gratuito de verdade: sem chave, sem limite.
# Instale um modelo local: ollama pull qwen2.5:7b   (ou llama3.2:3b se a maquina for fraca)
# Deixe OLLAMA_MODEL vazio para o Vigia detectar sozinho o que voce tem instalado.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Operação ---
# Intervalo mínimo entre checagens da MESMA url, em minutos. Não baixe de 360 no starter.
MIN_INTERVAL_MIN=360
# Pausa entre requisições (segundos). Você é um visitante, não um DDoS.
REQUEST_DELAY_S=2
# Mudanças menores que isso em caracteres são tratadas como ruído.
MIN_DIFF_CHARS=40
# URL pública que identifica seu bot no User-Agent
BOT_INFO_URL=https://github.com/SilasJohan/vigia
